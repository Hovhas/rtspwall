#!/bin/sh
# postinst for rtspwall. Does not enable or start the service and never
# modifies config.txt.
set -e

CONF_DIR=/etc/rtspwall
CONF=$CONF_DIR/cameras.conf
EXAMPLE=/usr/share/doc/rtspwall/examples/cameras.conf

case "$1" in
    configure)
        if ! getent passwd rtspwall >/dev/null; then
            adduser --system --group --no-create-home --home /nonexistent \
                --shell /usr/sbin/nologin --quiet rtspwall
        fi
        adduser --quiet rtspwall video
        if getent group render >/dev/null; then adduser --quiet rtspwall render; fi

        install -d -m 0750 -o root -g rtspwall "$CONF_DIR"
        if [ -e "$CONF" ]; then
            chown root:rtspwall "$CONF"
            chmod 0640 "$CONF"
        elif [ -f "$EXAMPLE" ]; then
            install -m 0640 -o root -g rtspwall "$EXAMPLE" "$CONF"
        fi

        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            # Upgrade: restart only if it was already running.
            systemctl try-restart rtspwall.service || true
        fi

        gpu=""
        for f in /boot/firmware/config.txt /boot/config.txt; do
            if [ -f "$f" ]; then
                gpu=$(sed -n 's/^gpu_mem=\([0-9]\{1,\}\)[[:space:]]*$/\1/p' "$f" | tail -n1)
                break
            fi
        done
        if [ -z "$gpu" ] || [ "$gpu" -lt 256 ]; then
            echo "rtspwall: WARNING: gpu_mem is ${gpu:-unset (default)} in config.txt." >&2
            echo "rtspwall: 4 or more concurrent 1080p decoders need gpu_mem=256." >&2
            echo "rtspwall: Add 'gpu_mem=256' to /boot/firmware/config.txt and reboot." >&2
        fi

        echo "rtspwall: edit $CONF, run 'sudo rtspwall --check-config $CONF'," >&2
        echo "rtspwall: then 'systemctl enable --now rtspwall'. It is not started automatically." >&2
        ;;
    abort-upgrade | abort-remove | abort-deconfigure) ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
