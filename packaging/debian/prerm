#!/bin/sh
set -e

case "$1" in
    remove | deconfigure)
        if [ -d /run/systemd/system ]; then
            systemctl stop rpi4-rtsp.service || true
            systemctl disable rpi4-rtsp.service >/dev/null 2>&1 || true
        fi
        ;;
    upgrade | failed-upgrade) ;; # postinst does try-restart
    *)
        echo "prerm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
