[Unit]
Description=rtspwall - RTSP video wall on the Raspberry Pi 4 (DRM/KMS, V4L2 hardware decode)
Documentation=https://github.com/Hovhas/rtspwall
After=network-online.target
Wants=network-online.target
# Never give up permanently on transient failures: a camera or network outage
# must not leave the screen dead. (Must live in [Unit]; systemd ignores it in
# [Service].) Permanent failures (exit 2/3) are excluded via
# RestartPreventExitStatus below instead of via a start limit.
StartLimitIntervalSec=0

# Deliberately no Conflicts=getty@tty1.service: a text getty on tty1 is not a
# DRM master, so it does not get in the way. Only a competing display server
# (X11, Wayland compositor, another KMS client) on the same output does.
# Do not run one on the screen you give to rtspwall.

[Service]
# Type=notify: the daemon sends READY=1 and STATUS=... (e.g. "5/6 live; garage:
# 401") through $NOTIFY_SOCKET, visible in `systemctl status rtspwall`.
Type=notify
NotifyAccess=main
# The daemon waits for a screen instead of crashing, and sends READY=1 once it
# is up; 120 s is a generous upper bound for slow boots/cold HDMI links.
TimeoutStartSec=120
ExecStart=/usr/bin/rtspwall /etc/rtspwall/cameras.conf
# NOTE: /usr/bin is the packaged path. install.sh rewrites it to
# $PREFIX/bin (default /usr/local/bin) for source installs.

User=rtspwall
Group=rtspwall
# video: /dev/dri/card*, /dev/video10; render: /dev/dri/renderD*, /dev/dma_heap/*
SupplementaryGroups=video render

# Restart on crashes and other failures, never on a clean stop. Exit codes the
# daemon uses for problems a restart cannot fix are excluded, so there is no
# restart loop:
#   2 = config error / no cameras configured   (fix cameras.conf)
#   3 = no H.264 hardware decoder (e.g. Pi 5)  (unsupported hardware)
# 2 and 3 are used ONLY for permanent errors: transient start-up conditions
# (no screen yet, DRM busy, network not up) make the daemon wait instead of
# exiting, so they never reach these codes. A unit that ends up "failed" with
# 2/3 is restarted by rtspwall-config.service after the config is fixed.
Restart=on-failure
RestartPreventExitStatus=2 3
RestartSec=2
# Exponential backoff 2 s -> 60 s over 5 steps. RestartSteps/RestartMaxDelaySec
# need systemd >= 254; Bookworm ships 252, which ignores them (a harmless
# "Unknown key" warning) and keeps the flat RestartSec=2 there.
RestartSteps=5
RestartMaxDelaySec=60
KillSignal=SIGTERM
TimeoutStopSec=10

# ---------------------------------------------------------------------------
# Hardening.
#
# Safe core: none of these touch DRM master, V4L2 or dmabuf, and they are
# expected to work as-is. Still, verify on a real Pi 4 before a release:
#   systemctl start rtspwall; journalctl -u rtspwall -b
#   systemd-analyze security rtspwall
# ---------------------------------------------------------------------------
# No core dumps: a crash must not write camera credentials (RTSP URLs) to disk.
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# The program needs no capabilities: as a non-root member of "video" it
# becomes DRM master by being the first client to open the card.
# UNVERIFIED: if drmSetMaster fails with EACCES/EPERM on your kernel, check
# that no other process holds the card, before ever adding CAP_SYS_ADMIN.
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
SystemCallArchitectures=native
# UNVERIFIED (moderately safe): if the service dies with SIGSYS, see
# "journalctl -k | grep audit" / "systemd-analyze syscall-filter", and relax.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

# ---------------------------------------------------------------------------
# Opt-in hardening. Left OFF because it can break DRM/V4L2/dmabuf or
# FFmpeg in ways that cannot be tested off-device. Enable one at a time
# (systemctl edit rtspwall, or uncomment here), restart, and confirm that
# all camera tiles still show live video.
# ---------------------------------------------------------------------------
# UNVERIFIED: FFmpeg/libdrm may map W+X memory on some builds.
#MemoryDenyWriteExecute=yes
# UNVERIFIED: device allow-list. The DRM, V4L2 and dma-heap nodes are needed;
# char-* names come from /proc/devices, check them there (the dma_heap
# entry in particular). A missing node here breaks dmabuf import.
#DevicePolicy=closed
#DeviceAllow=char-drm rw
#DeviceAllow=char-video4linux rw
#DeviceAllow=/dev/dma_heap rw
#DeviceAllow=/dev/dma_heap/linux,cma rw
#DeviceAllow=/dev/dma_heap/system rw

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
